<?xml version="1.0" encoding="utf-8"?>
<!--
    What a widget shows before the app has drawn it: just placed, just updated, just rebooted.
    Glance's default here is a bare spinner, which reads as "broken" if the first draw is slow.
    This says whose widget it is and that the list is on its way.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_initial_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:importantForAccessibility="no"
        android:src="@drawable/cat_badge" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/app_name"
        android:textColor="@color/widget_initial_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/widget_initial_hint"
        android:textColor="@color/widget_initial_hint"
        android:textSize="12sp" />
</LinearLayout>
